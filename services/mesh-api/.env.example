# Stepwise Mesh API

MAX_VIDEO_SECONDS=120
TARGET_MESH_FPS=24
CORS_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-PROJECT.vercel.app

# Cloudflare R2 / S3-compatible object storage
STORAGE_BACKEND=r2
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=stepwise-mesh
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_PRESIGN_TTL_SECONDS=900
RESULT_PRESIGN_TTL_SECONDS=3600

# Railway Postgres / durable job store (next implementation step)
DATABASE_URL=

# Modal GPU worker handoff (next implementation step)
MODAL_GPU_WORKER_URL=
MODAL_GPU_WORKER_TOKEN=
