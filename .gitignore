!packages/beat-detect/python/tests/fixtures/*.mp4

# Tooling
.pytest_cache/
.ruff_cache/
.DS_Store
screenshots/
qa-reports/
.playwright-mcp/
.gstack/

# Local evaluation clip cache
.stepwise-clips/
