{
  // The Worker that serves apps/web. `npm run cf:deploy` builds and uploads it.
  //
  // `main` and `assets.directory` both point into `.open-next/`, which is
  // generated: it is the adapter's output, not source, and is gitignored.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stepwise",
  "main": ".open-next/worker.js",

  // nodejs_compat is not optional. Next's server runtime reaches for node:
  // builtins (async_hooks above all, which React server components require),
  // and without the flag the Worker fails at *startup* with a module
  // resolution error rather than on any particular request -- so it reads as a
  // broken build rather than a missing flag.
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Where app/api/[...path]/route.ts sends /api/*. STEPWISE_ORIGIN_KEY is a
  // secret, not a var: `wrangler secret put STEPWISE_ORIGIN_KEY`.
  "vars": {
    "MOTION_API_URL": "https://sreshta-talluri--stepwise-motion-web.modal.run"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Cloudflare's own request logs. Same argument as Sentry: a failure nobody
  // can read is a failure nobody can fix. Included with Workers Paid.
  "observability": {
    "enabled": true
  }
}
